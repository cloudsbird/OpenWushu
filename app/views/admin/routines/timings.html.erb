<% content_for :title, "#{@routine.name_zh} · #{t("admin.routines.timings.title")}" %>
<main class="container">
  <%= render "admin/shared/header", tab: :routines %>
  <p class="breadcrumb"><%= link_to t("admin.routines.back"), admin_routines_path %> · <%= link_to @routine.name_zh, edit_admin_routine_path(@routine) %></p>

  <section class="panel admin-panel" data-controller="timing-editor" data-action="keydown@window->timing-editor#key">
    <h2 class="heading heading--ruled"><span class="heading__zh">动作时间</span><span class="heading__tr"><%= @routine.name_zh %> · <%= t("admin.routines.timings.title") %></span></h2>

    <div class="timing-layout">
    <%# The video and its controls stay on screen while the list scrolls %>
    <div class="timing-player">
      <% if @routine.video? %>
        <div class="stage has-video timing-stage">
          <% if @routine.video.attached? %>
            <video data-timing-editor-target="video" src="<%= rails_storage_proxy_path(@routine.video) %>" preload="metadata" playsinline controls></video>
          <% else %>
            <div class="stage__youtube" data-timing-editor-target="youtube" data-video-id="<%= @routine.youtube_id %>"></div>
          <% end %>
        </div>
        <p class="timing-now">
          <span class="mono" aria-live="off"><span data-timing-editor-target="now">0:00.0</span></span>
          <span lang="zh" data-timing-editor-target="playing"></span>
        </p>
        <div class="admin-actions admin-actions--row">
          <button type="button" class="btn btn--accent" data-action="timing-editor#markNext"><%= t("admin.routines.timings.mark_next") %></button>
          <button type="submit" class="btn" form="timing-form"><%= t("admin.save") %></button>
          <label class="check"><input type="checkbox" checked data-timing-editor-target="follow"><span><%= t("admin.routines.timings.follow") %></span></label>
        </div>
        <details class="timing-help">
          <summary><%= t("admin.routines.timings.how") %></summary>
          <p class="field__hint"><%= t("admin.routines.timings.lead") %></p>
        </details>
      <% else %>
        <p class="muted"><%= t("admin.routines.timings.no_video") %></p>
      <% end %>
    </div>

    <div class="timing-list">
    <% if @routine.errors.any? %>
      <p class="field__error"><%= @routine.errors.full_messages.to_sentence %></p>
    <% end %>

    <details class="timing-paste">
      <summary><%= t("admin.routines.timings.paste_title") %></summary>
      <p class="field__hint"><%= t("admin.routines.timings.paste_hint") %></p>
      <textarea class="input timing-paste__text" rows="8" data-timing-editor-target="paste" aria-label="<%= t("admin.routines.timings.paste_title") %>" placeholder="1 12.0&#10;2 14.5&#10;…&#10;END 305.0"></textarea>
      <div class="admin-actions admin-actions--row">
        <button type="button" class="btn btn--accent" data-action="timing-editor#fill"><%= t("admin.routines.timings.paste_fill") %></button>
        <span class="muted" role="status" data-timing-editor-target="pasteResult"
              data-filled="<%= t("admin.routines.timings.paste_filled") %>"
              data-missing="<%= t("admin.routines.timings.paste_missing") %>"
              data-unsure="<%= t("admin.routines.timings.paste_unsure") %>"></span>
      </div>
    </details>

    <%= form_with url: timings_admin_routine_path(@routine), method: :patch, scope: :timings, class: "form", id: "timing-form" do |form| %>
      <table class="table timing-table">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col"><%= t("admin.routines.timings.movement") %></th>
            <th scope="col"><%= t("admin.routines.timings.start") %></th>
            <th scope="col"><span class="visually-hidden"><%= t("admin.routines.timings.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% rows = @movements.map { |m| [ "timings[starts][#{m.number}]", @starts&.[](m.number.to_s) || m.start_sec, "#{m.cn_label} #{m.name_zh}", m.name_tr, m.number ] } %>
          <% rows << [ "timings[finish]", @finish || @movements.last&.end_sec, t("admin.routines.timings.finish"), nil, "end" ] %>
          <% rows.each_with_index do |(name, value, zh, tr, key), i| %>
            <tr data-timing-editor-target="row">
              <td class="mono"><%= i < @movements.size ? @movements[i].number : "—" %></td>
              <td><span lang="zh" data-timing-editor-target="name"><%= zh %></span><% if tr %> <span class="muted"><%= tr %></span><% end %></td>
              <td><%= number_field_tag name, value, step: 0.1, min: 0, required: true, class: "input timing-input", data: { timing_editor_target: "start", key: key }, "aria-label": "#{zh} #{t("admin.routines.timings.start")}" %></td>
              <td class="timing-actions">
                <% if @routine.video? %>
                  <button type="button" class="btn" data-action="timing-editor#mark" data-timing-editor-index-param="<%= i %>"><%= t("admin.routines.timings.mark") %></button>
                  <button type="button" class="btn" data-action="timing-editor#jump" data-timing-editor-index-param="<%= i %>"><%= t("admin.routines.timings.play") %></button>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="admin-actions admin-actions--row">
        <%= form.submit t("admin.save"), class: "btn btn--accent" %>
        <% if @routine.published? %><%= link_to t("admin.routines.view"), routine_path(@routine), class: "btn" %><% end %>
      </div>
    <% end %>
    </div>
    </div>
  </section>
</main>
