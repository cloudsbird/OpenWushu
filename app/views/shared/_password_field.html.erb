<%# A password input with a Show/Hide button; errors and a hint are tied to it for screen readers %>
<% hint = nil if local_assigns[:error].present? %>
<% described = [ ("#{id}-hint" if hint), ("#{id}-error" if local_assigns[:error].present?) ].compact.join(" ").presence %>
<div class="field" data-controller="password-visibility" data-password-visibility-show-value="<%= t("auth.show") %>" data-password-visibility-hide-value="<%= t("auth.hide") %>">
  <%= yield %>
  <div class="field__row">
    <%= form.password_field name, id: id, class: "input", required: true, autocomplete: autocomplete, maxlength: 72, "aria-describedby": described, "aria-invalid": (local_assigns[:error].present? || nil), data: { password_visibility_target: "input" } %>
    <button type="button" class="btn field__toggle" aria-pressed="false" aria-controls="<%= id %>" data-password-visibility-target="button" data-action="password-visibility#toggle"><%= t("auth.show") %></button>
  </div>
  <% if hint %><span id="<%= id %>-hint" class="field__hint"><%= hint %></span><% end %>
  <% if local_assigns[:error].present? %><span id="<%= id %>-error" class="field__error"><%= error %></span><% end %>
</div>
