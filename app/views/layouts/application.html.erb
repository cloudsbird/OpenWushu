<!DOCTYPE html>
<html lang="<%= I18n.locale == :id ? "id" : "en" %>">
  <head>
    <title><%= [ content_for(:title), "#{site_settings.site_name} 开放武术" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# The header seal: 武 over 术 on blue (glyphs drawn as paths, so no font is needed) %>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400..800;1,400..700&family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;0,800;1,400&family=IBM+Plex+Mono:wght@400;500&family=Ma+Shan+Zheng&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@500;600;700;900&display=swap">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="page">
      <%# On phones the bar is the logo, the translation switch and a menu button; the menu holds the rest %>
      <header class="site-header" data-controller="menu" data-action="keydown.esc@window->menu#close click@window->menu#closeOutside">
        <div class="site-header__inner">
          <%= link_to root_path, class: "brand", "aria-label": t("layout.home") do %>
            <span class="seal" aria-hidden="true"><span>武</span><span>术</span></span>
            <span class="brand__text"><span class="brand__name"><%= site_settings.site_name %></span><span class="brand__zh">开放武术</span></span>
          <% end %>
          <div class="lang-switch">
            <span class="lang-switch__label">中文 + <%= t("layout.translation") %></span>
            <div class="segmented" role="group" aria-label="<%= t("layout.translation_group") %>">
              <% { en: "EN", id: "ID" }.each do |code, label| %>
                <%= link_to label, url_for(request.query_parameters.merge(locale: code)), class: "segmented__item", "aria-pressed": (I18n.locale == code).to_s, hreflang: code, lang: code %>
              <% end %>
            </div>
          </div>
          <button type="button" class="btn btn--icon menu-toggle" aria-expanded="false" aria-controls="site-menu" data-menu-target="button" data-action="menu#toggle">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 5 H17 M3 10 H17 M3 15 H17"/></svg>
            <span class="visually-hidden"><%= t("layout.menu") %></span>
          </button>
          <div class="site-menu" id="site-menu" data-menu-target="panel">
            <nav class="site-nav" aria-label="Main">
              <%= link_to t("layout.library"), root_path, class: "site-nav__link", "aria-current": (controller_path == "routines" ? "page" : nil) %>
              <% if authenticated? && Current.user.admin? %>
                <%= link_to t("layout.admin"), admin_root_path, class: "site-nav__link", "aria-current": (controller_path.start_with?("admin/") ? "page" : nil) %>
              <% end %>
            </nav>
            <div class="account">
              <% if authenticated? %>
                <span class="account__name"><%= Current.user.display_name %></span>
                <% unless Current.user.verified? %>
                  <%= link_to t("layout.unverified"), email_verification_path, class: "badge badge--amber" %>
                <% end %>
                <%= button_to t("layout.sign_out"), session_path, method: :delete, class: "btn", form_class: "account__form" %>
              <% else %>
                <%= link_to t("layout.sign_in"), new_session_path, class: "btn" %>
                <% if site_settings.signups_open? %>
                  <%= link_to t("layout.sign_up"), new_registration_path, class: "btn btn--accent" %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </header>

      <% if site_settings.notice %>
        <div class="site-notice" role="note"><p><%= site_settings.notice %></p></div>
      <% end %>

      <%# Account pages show messages inside their form instead %>
      <% if flash.any? && !content_for?(:auth) %>
        <div class="flash-bar"><%= render "shared/flash" %></div>
      <% end %>

      <%= yield %>

      <footer class="site-footer">
        <p>
          <%= site_settings.footer || t("layout.footer") %> ·
          <%# The licence of the content is fixed: changing a link would not relicense contributions %>
          <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license noopener" target="_blank"><%= t("layout.license") %></a> ·
          <%= link_to t("layout.source_code"), site_settings.source_url, rel: "noopener", target: "_blank" %>
          <% if site_settings.contact_email %> · <%= mail_to site_settings.contact_email, t("layout.contact") %><% end %>
        </p>
      </footer>
    </div>
  </body>
</html>
