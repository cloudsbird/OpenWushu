<!DOCTYPE html>
<html lang="<%= I18n.locale == :id ? "id" : "en" %>">
  <head>
    <title><%= [ content_for(:title), "OpenWushu 开放武术" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400..800;1,400..700&family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;0,800;1,400&family=IBM+Plex+Mono:wght@400;500&family=Ma+Shan+Zheng&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@500;600;700;900&display=swap">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="page">
      <header class="site-header">
        <div class="site-header__inner">
          <%= link_to root_path, class: "brand", "aria-label": t("layout.home") do %>
            <span class="seal" aria-hidden="true"><span>武</span><span>术</span></span>
            <span class="brand__text"><span class="brand__name">OpenWushu</span><span class="brand__zh">开放武术</span></span>
          <% end %>
          <nav class="site-nav" aria-label="Main">
            <%= link_to t("layout.library"), root_path, class: "site-nav__link", "aria-current": (controller_name == "routines" ? "page" : nil) %>
          </nav>
          <div class="lang-switch">
            <span class="lang-switch__label">中文 + <%= t("layout.translation") %></span>
            <div class="segmented" role="group" aria-label="<%= t("layout.translation_group") %>">
              <% { en: "EN", id: "ID" }.each do |code, label| %>
                <%= link_to label, url_for(request.query_parameters.merge(locale: code)), class: "segmented__item", "aria-pressed": (I18n.locale == code).to_s, hreflang: code, lang: code %>
              <% end %>
            </div>
          </div>
        </div>
      </header>

      <%= yield %>

      <footer class="site-footer">
        <p>
          <%= t("layout.footer") %> ·
          <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license noopener" target="_blank"><%= t("layout.license") %></a> ·
          <a href="https://github.com/cloudsbird/OpenWushu" rel="noopener" target="_blank"><%= t("layout.source_code") %></a>
        </p>
      </footer>
    </div>
  </body>
</html>
